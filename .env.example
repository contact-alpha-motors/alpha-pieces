# ---- Application ----
PORT=3000
HOST_PORT=18300                                     # port publié sur le VPS ; changer en cas de conflit
PUBLIC_URL=https://pieces.alphamotors.example      # URL publique du site (HTTPS)
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire   # openssl rand -hex 32

# ---- Base de données ----
POSTGRES_USER=alpha
POSTGRES_PASSWORD=remplacer-mot-de-passe-fort
POSTGRES_DB=alpha_pieces
DATABASE_URL=postgres://alpha:remplacer-mot-de-passe-fort@db:5432/alpha_pieces

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...                    # fourni par @BotFather
TELEGRAM_MODE=webhook                               # webhook (production) ou polling (test)
TELEGRAM_WEBHOOK_SECRET=remplacer-chaine-aleatoire  # openssl rand -hex 24

# ---- IA (OpenRouter) ----
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=z-ai/glm-5.3-flash
AI_PROVIDER=                                        # optionnel : fixer un fournisseur, ex. z-ai
